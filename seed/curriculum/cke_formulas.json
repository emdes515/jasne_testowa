      "title": "Iloczyn i iloraz pod pierwiastkiem",
      "formula": "\\sqrt[n]{a \\cdot b} = \\sqrt[n]{a} \\cdot \\sqrt[n]{b}, \\qquad \\sqrt[n]{\\frac{a}{b}} = \\frac{\\sqrt[n]{a}}{\\sqrt[n]{b}}",
      "subFormulas": [
        {
          "label": "Iloczyn pod pierwiastkiem",
          "formula": "\\sqrt[n]{a \\cdot b} = \\sqrt[n]{a} \\cdot \\sqrt[n]{b}"
