    {
      "id": "f-log-2",
      "topicId": "logarytmy-procenty",
      "topicName": "Logarytmy i Procenty",
      "title": "Działania na logarytmach (suma, różnica, potęga)",
      "formula": "\\log_a(x \\cdot y) = \\log_a x + \\log_a y",
      "subFormulas": [
        {
          "label": "Suma logarytmów",
          "formula": "\\log_a x + \\log_a y = \\log_a(x \\cdot y)"
