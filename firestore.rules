rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Connection test document
    match /test/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  
    // System metadata - read only for authenticated users
    match /system/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // Admin only via Admin SDK / service account
    }
    
    // Subjects (Przedmioty) -> Topics (Działy) -> Lessons (Lekcje)
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if false; // Admin only via Admin SDK / service account

      match /topics/{topicId} {
        allow read: if true;
        allow write: if false;

        match /lessons/{lessonId} {
          allow read: if true;
          allow write: if false;
        }
      }
    }

    
    // Legacy collections (read-only for migration)
    match /mathTasks/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /zadania_matura/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Users Profile and Progress - SECURED: users can only access their own data
    match /users/{userId} {
      // Users can ONLY read their own profile, not others
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Subcollection progress: users/{userId}/progress/{topicId}
      match /progress/{topicId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Any other user subcollections - strictly isolated per user
      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Arena multiplayer matches - only participants can access
    match /matches/{matchId} {
      allow read: if request.auth != null && 
        (resource.data.player1Id == request.auth.uid || 
         resource.data.player2Id == request.auth.uid ||
         (!resource.exists() && request.auth != null)); // Allow create
      allow write: if request.auth != null && 
        (resource.data.player1Id == request.auth.uid || 
         resource.data.player2Id == request.auth.uid ||
         (!resource.exists())); // Allow create
    }
    
    // Default fallback - DENY ALL by default for security
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
