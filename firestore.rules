rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Connection test document
    match /test/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // System metadata
    match /system/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Subjects (Przedmioty) -> Topics (Działy) -> Lessons (Lekcje)
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if false; // Admin only via Admin SDK / service account

      match /topics/{topicId} {
        allow read: if true;
        allow write: if false;

        match /lessons/{lessonId} {
          allow read: if true;
          allow write: if false;
        }
      }
    }

    // Alias dla kolekcji przedmioty
    match /przedmioty/{przedmiotId} {
      allow read: if true;
      allow write: if false;

      match /{allChildren=**} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Topics (Działy) and Subcollection Lessons (Lekcje) - Fallback/Mirror
    match /topics/{topicId} {
      allow read: if true;
      allow write: if false; // Admin only via Admin SDK / service account

      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if false; // Admin only via Admin SDK / service account
      }
    }
    
    // Legacy collections (optional read access during migration)
    match /mathTasks/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /zadania_matura/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Users Profile and Progress
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Subcollection progress: users/{userId}/progress/{topicId}
      match /progress/{topicId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Any other user subcollections
      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Arena multiplayer matches
    match /matches/{matchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
